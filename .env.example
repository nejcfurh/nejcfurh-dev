# Copy to .env.local and fill in. Every value is optional: without it the
# matching feature stays off (analytics) or shows a "not configured" toast (contact form).

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# development | staging | preview | production — events are only sent outside development
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_VERSION=

# EmailJS contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
